# Copy this file to .env and fill in your own keys. .env is git-ignored.
# Every key is optional: providers without a key are skipped and shown as SKIPPED
# in the output, so you always see exactly which sources contributed to a verdict.
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
# One abuse.ch Auth-Key (https://auth.abuse.ch) covers URLhaus, MalwareBazaar and ThreatFox
ABUSECH_API_KEY=
# Optional overrides
# SOAR_DATA_DIR=C:\soar-data
# SOAR_MAX_IOCS=50